# Copy this file to .env (same folder) and paste your key. Never commit .env or share the key.
# AI provider: Groq only. Without a key the app runs on the offline rule engine.
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# Optional: override the model (default is set in app/llm.py). Pick a tool-calling model from https://console.groq.com/docs/models
# FINBRIDGE_MODEL=

# --- optional app settings (defaults are fine for local use) ---
# FINBRIDGE_ENV=development          # production => Secure cookies, HSTS, no /docs
# FINBRIDGE_DB=data/finbridge.db
# FINBRIDGE_CORS=http://localhost:8000
# FINBRIDGE_SESSION_HOURS=12
# FINBRIDGE_OFFLINE=1                # no network, rule engine only
# Password-reset email (otherwise the link is printed in the server console, dev only):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
